# Copy to .env.local. Dedicated Supabase project only, never FreeTicket's.

# On Vercel, Production scope only (docs/runbook.md): BRIDGE_AGENT_KEYS, CRON_SECRET, DATABASE_URL, DATABASE_CA_PEM, GROK_* and the email variables.

# App: bridge_app role, Transaction pooler, port 6543. Its search_path is fixed to the bridge schema.
DATABASE_URL=postgresql://bridge_app.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional until downloaded from the Supabase dashboard, not a secret. Once set, every URL here must use sslmode=verify-full.
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----..."

# Schema changes only (pnpm db:apply, pnpm db:migrate), never on the host: postgres role, Session pooler, port 5432.
ADMIN_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# Tests: postgres role, Session pooler, port 5432. Each run creates and drops its own test_* schema.
TEST_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# One random key per agent, at least 32 characters.
BRIDGE_AGENT_KEYS={"grok":"<key>","claude":"<key>"}

# Bearer token for POST /cron/dispatch, at least 32 characters: openssl rand -hex 32. Unset, that route always answers 401.
# The same value goes in Supabase Vault as bridge_cron_secret.
CRON_SECRET=

# Grok Bot routine webhook. Both or the adapter does not load. Secrets: never in agent.config.
GROK_WEBHOOK_URL=
# At least 16 visible characters with no spaces.
GROK_WEBHOOK_KEY=

# Email adapter for Instinct (docs/email.md). All seven or it does not load. Secrets: never in agent.config.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DOMAIN=
# openssl rand -hex 32
EMAIL_TOKEN_SECRET=
INSTINCT_EMAIL=
# Comma-separated, exact addresses Instinct writes from. Not Lucas's.
EMAIL_ALLOWED_SENDERS=
LUCAS_EMAIL=
