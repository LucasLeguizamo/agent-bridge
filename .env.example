# Copy to .env.local. Use a dedicated Postgres project, never one shared with another product.
# On Vercel, set these in the Production scope only (docs/runbook.md).

# ---- Required ----

# App role (bridge_app), transaction pooler, port 6543. Its search_path is fixed to the bridge schema.
DATABASE_URL=postgresql://bridge_app.<ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# One random key per agent, 32+ characters: openssl rand -hex 32. Each id also needs a row in bridge.agent.
BRIDGE_AGENT_KEYS={"grok":"<key>","claude":"<key>"}

# ---- Dispatcher ----

# Bearer for POST /cron/dispatch, 32+ characters. The same value goes in Supabase Vault as bridge_cron_secret.
# Unset, that route always answers 401 and tasks are only sent right after they are created.
CRON_SECRET=

# ---- Routine adapter (Grok Bot). Both, or it does not load ----

GROK_WEBHOOK_URL=
# 16+ visible characters, no spaces.
GROK_WEBHOOK_KEY=

# ---- Email adapter (Instinct). All six, or it does not load (docs/email.md) ----

RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_DOMAIN=
# openssl rand -hex 32
EMAIL_TOKEN_SECRET=
INSTINCT_EMAIL=
# Optional. Comma-separated addresses Instinct writes from. Default: INSTINCT_EMAIL. Never the owner's.
# EMAIL_ALLOWED_SENDERS=
# The owner's address, in Cc of every email: agents work without asking, so this is how you see each task.
# (LUCAS_EMAIL is still read as its old name.)
OWNER_EMAIL=

# ---- Optional ----

# The database CA, from the Supabase dashboard. Not a secret. Once set, every URL here must use sslmode=verify-full.
# DATABASE_CA_PEM="-----BEGIN CERTIFICATE-----..."

# ---- Local only, never on the host ----

# Schema changes (pnpm db:apply, pnpm db:migrate): postgres role, session pooler, port 5432.
ADMIN_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true

# Tests: postgres role, session pooler, port 5432. Each run creates and drops its own test_* schema.
TEST_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&uselibpqcompat=true
