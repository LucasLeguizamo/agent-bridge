{
  "name": "agent-bridge",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.local src/main.ts",
    "db:apply": "node --env-file-if-exists=.env.local db/apply.ts",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.ts",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 --test-timeout=240000 test/core.test.ts test/memory.test.ts test/grok.test.ts test/ops.test.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
